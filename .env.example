# OpenRouter API key — used to generate the stickman images (replaces Magnific).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Image model served by OpenRouter. FLUX.1 Schnell is no longer listed in
# OpenRouter's image catalog (superseded by the FLUX.2 line as of mid-2026).
# We benchmarked several options on the same prompt:
#   - black-forest-labs/flux.2-klein-4b: cheapest/fastest but garbled text and
#     stray artifacts — not usable for this style.
#   - black-forest-labs/flux.2-pro / flex / max: clean, but more polished than
#     the requested MS-Paint doodle look.
#   - bytedance-seed/seedream-4.5: best match for "thick black outlines, flat
#     colors, amateur MS Paint aesthetic" — flat $0.04/image. Set as default.
# Override here to try another model.
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5

# Gemini API key — used for narration (text-to-speech).
# Free key at https://aistudio.google.com/apikey
# Why Gemini and not OpenRouter: OpenRouter's only audio-output models
# (openai/gpt-audio, gpt-audio-mini) are conversational voice models — tested
# them with several prompt strategies and they kept adding chatter ("Claro,
# aquí va la frase...") instead of reading the script verbatim. Gemini's
# *-tts models are dedicated TTS engines with no chat behavior.
GEMINI_API_KEY=

# gemini-2.5-flash-preview-tts ($10/1M audio output tokens, ~25 tok/s ≈
# $0.015/minute of narration) or gemini-2.5-pro-preview-tts (2x price, only
# worth it if flash's prosody/quality isn't good enough).
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Any Gemini prebuilt voice name (Kore, Puck, Charon, Fenrir, Aoede, ...).
# Kore is a calm, neutral default that works well for narration.
GEMINI_TTS_VOICE=Kore
